# All values are server-only. Never use NEXT_PUBLIC_ for provider configuration.
APP_ORIGIN=http://localhost:3000
# Supabase API connection. No DATABASE_URL or secret/service-role key needed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Long-term IAM access keys. AWS session tokens are not used.
AWS_REGION=ap-northeast-2
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SQL Editor bootstrap only: npm run db:prepare (or db:seed for existing tables).
INITIAL_MEMBER_PASSWORD=
INITIAL_SUB_ADMIN_PASSWORD=
INITIAL_ADMIN_PASSWORD=

# POST /api/maintenance with Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
